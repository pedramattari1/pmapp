# apps/web/.env.local — copy to .env.local and fill in. NEVER commit real secrets.
# Values you provision per SETUP.md §3–§4.

# Clerk publishable key (Clerk dashboard → API keys). Safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key (Clerk dashboard → API keys). Server-side only.
CLERK_SECRET_KEY=

# Base URL of the api service. Local: http://localhost:8080 ; prod: your Railway URL.
NEXT_PUBLIC_API_URL=http://localhost:8080

# UploadThing token — unused in Phase 0, fill later for photo uploads.
UPLOADTHING_TOKEN=
