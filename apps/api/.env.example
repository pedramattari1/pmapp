# apps/api/.env — copy to .env and fill in. NEVER commit the real .env.
# Values you provision per SETUP.md §3–§4.

# Postgres connection string from Railway (Postgres service → Variables)
DATABASE_URL=

# Clerk secret key (Clerk dashboard → API keys). Used to verify tokens server-side.
CLERK_SECRET_KEY=

# Resend API key — unused in Phase 0, fill later for email digests.
RESEND_API_KEY=

# Secret you invent; protects POST /internal/run-daily. Unused in Phase 0.
INTERNAL_RUN_SECRET=

# Allowed browser origin for CORS. Local: http://localhost:3000 ; prod: your Vercel URL.
WEB_ORIGIN=http://localhost:3000

# Port the api listens on.
PORT=8080
